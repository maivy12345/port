# Web3Forms (contact form)
# Free plan: submit from the browser only (see js/contact-config.js).
# In Web3Forms dashboard → Settings → Allowed Domains, add:
#   meivy-productdesigner.vercel.app
#
# Optional server proxy (api/contact.js) needs Web3Forms Pro + IP whitelist on Vercel.
# WEB3FORMS_ACCESS_KEY is only used if you enable the server route again.
WEB3FORMS_ACCESS_KEY=
